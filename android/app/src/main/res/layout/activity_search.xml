<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_home_gradient" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonBack" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:text="‹" android:textColor="@color/ink" android:textSize="34sp" />
        <EditText android:id="@+id/inputSearch" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:background="@drawable/bg_gold_pill" android:hint="搜索角色、流派或纹样" android:imeOptions="actionSearch" android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="15sp" />
    </LinearLayout>
    <TextView android:id="@+id/textCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingTop="10dp" android:paddingEnd="20dp" android:paddingBottom="12dp" android:textColor="@color/muted" android:textSize="12sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="20dp">
        <LinearLayout android:id="@+id/resultContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
